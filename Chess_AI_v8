// 오직 기물 잡기(Capture)만 추출하는 함수
const getCaptureMoves = (boardState, color) => {
    const allMoves = getLegalMoves(boardState, color);
    // 목적지에 기물이 있는 경우(Capture)만 필터링
    return allMoves.filter(move => {
        const [toRow, toCol] = move.to;
        return boardState[toRow][toCol] !== null; 
    });
};

// QS 전용 기물 잡기 점수 산출 (MVV-LVA)
const getMvvLvaScore = (move, boardState) => {
    const [toRow, toCol, special] = move.to;
    let targetPiece = boardState[toRow][toCol];

    // [추가] 앙파상인 경우 목적지는 null이지만 실제로는 폰을 잡는 것임
    if (!targetPiece && special === 'enPassant') {
        targetPiece = (move.piece === move.piece.toUpperCase()) ? 'p' : 'P';
    }

    if (!targetPiece) return 0;
  
    ///////////////////
    if (isPromotionSituation(move.piece, move.to[0])) {
        return 90; // 어떤 일반적인 잡기보다 높은 점수를 주어 먼저 탐색하게 함
    }
  ///////////////////

    const victimValue = pieceValues[targetPiece.toUpperCase()];
    const aggressorValue = pieceValues[move.piece.toUpperCase()];

    return (victimValue * 10) - aggressorValue;
};

////////////////
const MAX_QS_DEPTH = 12; // 저사양 PC 권장: 2~4
let maxQsDepthReached = 0; // 한 수읽기 동안 도달한 최대 QS 깊이

const quiescenceSearch = (boardState, alpha, beta, maximizingPlayer, qsDepth = 0) => {
    nodesVisited++;
    if (qsDepth > maxQsDepthReached) maxQsDepthReached = qsDepth;
    const color = maximizingPlayer ? 'black' : 'white';
    
    // ✅ [추가] 현재 체크 상태인지 확인
    const isCheck = isInCheck(color, boardState);

    // 1. Stand Pat (체크 상태가 아닐 때만 수행)
    // 체크 상태라면 무조건 수를 두어 탈출해야 하므로 정적 평가를 생략합니다.
    if (!isCheck) {
        const [standPat, standPatDetails] = evaluateBoard(boardState, false, alpha, beta, 0);
        if (maximizingPlayer) {
            if (standPat >= beta) return [beta, standPatDetails];
            if (alpha < standPat) alpha = standPat;
        } else {
            if (standPat <= alpha) return [alpha, standPatDetails];
            if (beta > standPat) beta = standPat;
        }
    }

    if (qsDepth >= MAX_QS_DEPTH) {
        return evaluateBoard(boardState, false, alpha, beta, 0);
    }

    // 2. 이동 생성 및 필터링
    let moves = getLegalMoves(boardState, color);
    
    // ✅ [개선] 캡처, 앙파상뿐만 아니라 '프로모션' 수까지 포함
    let tacticalMoves = moves.filter(m => {
        const isCapture = boardState[m.to[0]][m.to[1]] !== null || m.to[2] === 'enPassant';
        const isPromotion = isPromotionSituation(m.piece, m.to[0]);
        // 체크 상태라면 모든 합법적인 수(탈출수)를 탐색, 아니면 전술적인 수만 탐색
        return isCheck || isCapture || isPromotion;
    });

    // 3. 정렬 (MVV-LVA)
    tacticalMoves.sort((a, b) => getMvvLvaScore(b, boardState) - getMvvLvaScore(a, boardState));

    let bestDetails = null;

    for (const move of tacticalMoves) {
        // 4. 델타 프루닝 (Delta Pruning) - 체크 상황이 아닐 때만 적용
        if (!isCheck) {
            const targetPiece = boardState[move.to[0]][move.to[1]];
            let gain = targetPiece ? pieceValues[targetPiece.toUpperCase()] : 0;
            if (isPromotionSituation(move.piece, move.to[0])) gain += 7; // 승급 가치 추가

            const DELTA_MARGIN = 2.0;
            if (maximizingPlayer) {
                // 현재 점수 + 잠재적 이득이 여전히 alpha보다 낮으면 이 가지는 볼 필요 없음
                // (단, evaluateBoard의 리턴 구조에 맞춰 standPat 변수 사용)
            }
        }

        makeMove(boardState, move);
        const [score, details] = quiescenceSearch(boardState, alpha, beta, !maximizingPlayer, qsDepth + 1);
        unmakeMove(boardState, move);

        if (maximizingPlayer) {
            if (score >= beta) return [beta, details];
            if (score > alpha) {
                alpha = score;
                bestDetails = details;
            }
        } else {
            if (score <= alpha) return [alpha, details];
            if (score < beta) {
                beta = score;
                bestDetails = details;
            }
        }
    }

    // 체크 상태인데 피할 수 있는 tacticalMoves가 하나도 없다면 (사실상 체크메이트)
    if (isCheck && tacticalMoves.length === 0) {
        return [maximizingPlayer ? -100000 + qsDepth : 100000 - qsDepth, null];
    }

    return [maximizingPlayer ? alpha : beta, bestDetails];
};
