const handleDrawScore = (boardState, maximizingPlayer, ply) => {
    const phase = getGamePhase();
    // 흑 기준 점수 (양수: 흑 유리, 음수: 백 유리)
    const [evalScore, _] = evaluateBoard(boardState);
    
    // ✅ 승리 정신 임계값 (WIN_SPIRIT_THRESHOLD)
    // 무승부를 패배로 간주하고 승리를 위해 싸웁니다.
    const WIN_SPIRIT_THRESHOLD = 1.0;

    // AI가 흑(Maximizing)일 때
    if (maximizingPlayer) {
        if (evalScore > -WIN_SPIRIT_THRESHOLD) {
            // 흑이 이기고 있거나, 비기고 있거나, 0.5점 이내로 조금만 지고 있다면
            // 무승부는 "당하기 싫은 패배"입니다.
            return -5000 + ply;
        } else {
            // 0.5점 넘게 확실히 지고 있다면
            // 무승부는 "달콤한 구원"입니다.
            return 5000 - ply;
        }
    } 
    // AI가 백(Minimizing)일 때
    else {
        if (evalScore < WIN_SPIRIT_THRESHOLD) {
            // 백이 이기고 있거나, 비기고 있거나, 0.5점 이내로 조금만 지고 있다면
            // (백은 음수일수록 유리하므로 0.5보다 작으면 승전보)
            return 5000 - ply; // 백에게 큰 양수 점수는 패배를 의미
        } else {
            // 확실히 지고 있다면
            return -5000 + ply; // 백에게 큰 음수 점수는 승리를 의미
        }
    }
};
