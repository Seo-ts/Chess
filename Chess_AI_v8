const BB_MASK = 0xFFFFFFFFFFFFFFFFn;

function seededRandom64(seed) {
    let state = BigInt(seed);
    return function() {
        state = (state + 0x9e3779b97f4a7c15n) & BB_MASK;
        let z = state;
        z = ((z ^ (z >> 30n)) * 0xbf58476d1ce4e5b9n) & BB_MASK;
        z = ((z ^ (z >> 27n)) * 0x94d049bb133111ebn) & BB_MASK;
        return (z ^ (z >> 31n)) & BB_MASK; // 모든 키를 64비트로 강제 제한
    };
}
