const checkIfMoveleadsToDraw = (fromRow, fromCol, toRow, toCol, piece, specialMove) => {
    const moveObj = { from: [fromRow, fromCol], to: [toRow, toCol, specialMove], piece: piece };
    
    // 1. 가상 이동 실행
    makeMove(internalBoardState, moveObj);
    
    // 2. 바뀐 턴 결정
    const nextColor = currentTurn === 'white' ? 'black' : 'white';
    
    // 3. 게임 종료 여부 확인 (시뮬레이션 모드)
    const result = isGameOver(nextColor, internalBoardState, true);
    
    // 4. 가상 이동 복구
    unmakeMove(internalBoardState, moveObj);
    
    // 결과가 무승부(50수, 3회반복, 스테일메이트)인지 여부 리턴
    return (result === "draw_50" || result === "draw_repetition" || result === "stalemate");
};
