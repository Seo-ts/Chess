const LAZY_MARGIN = 2.0;

const evaluateBoard = (boardState, isTuning = false, alpha = -Infinity, beta = Infinity, depth = 99) => {
    // ---------------------------------------------------------
    // [경로 B] 튜닝용 (Detailed Path) - 기존 로직 유지
    // ---------------------------------------------------------
    if (isTuning) {
        // [공통 정보 계산]
        const [bMat, _] = getMaterialScore(boardState, 'black', isTuning);
        const [wMat, __] = getMaterialScore(boardState, 'white', isTuning);
        const totalMaterial = bMat + wMat;
        const materialDiff = bMat - wMat; 

        const params = eval_weights.scalingParams || { 
            pawnEndgameIntensity: 1.0, 
            complexityReductionRate: 0.05, 
            globalPositionalWeight: 1.0 
        };

        const endgameContext = Math.max(0, 1.0 - (totalMaterial / 60));
        const pawnScale = 1.0 + (endgameContext * params.pawnEndgameIntensity);
        const advantageContext = Math.abs(materialDiff) / 10;
        const technicalScale = Math.max(0.1, 1.0 - (advantageContext * params.complexityReductionRate));
        const globalScale = params.globalPositionalWeight;
        const isEndgame = totalMaterial < ENDGAME_MATERIAL_THRESHOLD;

        let totalScore = materialDiff;
        let totalDetails = {}; 

        const mergeDetails = (source, sign) => {
            for (let key in source) {
                if (!totalDetails[key]) totalDetails[key] = { score: 0, feature: 0 };
                totalDetails[key].score += source[key].score * sign;
                totalDetails[key].feature += source[key].feature * sign;
            }
        };

        const blackKingPos = findKing('black', boardState);
        const whiteKingPos = findKing('white', boardState);

        const pstParts = { P: 0, N: 0, B: 0, R: 0, Q: 0, K: 0 };
        for (let r = 0; r < 8; r++) {
            for (let c = 0; c < 8; c++) {
                const piece = boardState[r][c];
                if (!piece) continue;
                const isWhite = piece === piece.toUpperCase();
                const pUpper = piece.toUpperCase();
                const sign = isWhite ? -1 : 1;
                const row = isWhite ? r : 7 - r;
                let val = 0;
                if (pUpper === 'P') val = pawnPositionValues[row][c];
                else if (pUpper === 'N') val = knightPositionValues[row][c];
                else if (pUpper === 'B') val = bishopPositionValues[row][c];
                else if (pUpper === 'R') val = rookPositionValues[row][c];
                else if (pUpper === 'Q') val = knightPositionValues[row][c] * 0.5;
                else if (pUpper === 'K') val = isEndgame ? kingEndGameValues[row][c] : kingMiddleGameValues[row][c];
                pstParts[pUpper] += val * sign;
            }
        }

        const piecesNames = ['P', 'N', 'B', 'R', 'Q', 'K'];
        piecesNames.forEach(p => {
            const key = `${p === 'P' ? 'pawn' : p === 'N' ? 'knight' : p === 'B' ? 'bishop' : p === 'R' ? 'rook' : p === 'Q' ? 'queen' : 'king'}_pst_w`;
            const weight = eval_weights[key] || 1.0;
            const score = pstParts[p] * weight * globalScale;
            totalScore += score;
            totalDetails[key] = { score: score, feature: pstParts[p] * globalScale };
        });

        const evalConfigs = [
            { fn: (s, c) => evaluatePawnStructure(s, c, true), scale: technicalScale * globalScale, paramKey: 'complexityReductionRate', context: -advantageContext },
            { fn: (s, c) => evaluatePassedPawns(s, c, true), scale: pawnScale * globalScale, paramKey: 'pawnEndgameIntensity', context: endgameContext }
        ];

        evalConfigs.forEach(config => {
            const [bScore, bDet] = config.fn(boardState, 'black');
            const [wScore, wDet] = config.fn(boardState, 'white');
            const rawDiff = bScore - wScore;
            const scaledDiff = rawDiff * config.scale;
            totalScore += scaledDiff;
            mergeDetails(bDet, 1 * config.scale);
            mergeDetails(wDet, -1 * config.scale);
            if (config.paramKey) {
                const pKey = `scalingParams_${config.paramKey}`;
                if (!totalDetails[pKey]) totalDetails[pKey] = { score: 0, feature: 0 };
                totalDetails[pKey].score += scaledDiff;
                totalDetails[pKey].feature += rawDiff * config.context * globalScale;
            }
        });

        if (isEndgame) {
            const [bEnd, bEndDet] = evaluateEndgameBonus(boardState, 'black', blackKingPos, whiteKingPos, bMat, wMat, true);
            const [wEnd, wEndDet] = evaluateEndgameBonus(boardState, 'white', whiteKingPos, blackKingPos, wMat, bMat, true);
            totalScore += (bEnd - wEnd) * globalScale;
            mergeDetails(bEndDet, 1 * globalScale);
            mergeDetails(wEndDet, -1 * globalScale);
        }

        const totalPositionalScore = totalScore - materialDiff;
        totalDetails['scalingParams_globalPositionalWeight'] = {
            score: totalPositionalScore,
            feature: Math.abs(totalPositionalScore) < 0.01 ? 0 : totalPositionalScore / Math.max(0.001, globalScale)
        };

        return [totalScore, totalDetails];
    }

    // ---------------------------------------------------------
    // [경로 A] 탐색용 (Fast Path): 통합 단일 순회 최적화
    // ---------------------------------------------------------
    
    // 1. 점진적으로 관리되는 기본 정보 가져오기 (O(1))
    const totalMaterial = totalWhiteMaterial + totalBlackMaterial;
    const isEndgame = totalMaterial < ENDGAME_MATERIAL_THRESHOLD;
    
    // 현재 단계에 맞는 기물+위치(PST) 합산 점수 가져오기
    let baseScore = isEndgame ? currentEGScore : currentMGScore;

    // ✅ [핵심] Step 1: Lazy Evaluation 조기 종료 로직
    // 튜닝 모드가 아닐 때만 작동
    if (!isTuning && depth <= 2) {
        // 상황 A: 기초 점수가 알파보다 너무 낮아서, 포지션 보너스를 다 더해도 가망이 없을 때 (Fail Low)
        if (baseScore + LAZY_MARGIN < alpha) {
            return [baseScore, null]; 
        }
        // 상황 B: 기초 점수가 베타보다 너무 높아서, 포지션 패널티를 다 고려해도 컷오프가 확실할 때 (Fail High)
        if (baseScore - LAZY_MARGIN > beta) {
            return [baseScore, null];
        }
    }

    // ---------------------------------------------------------
    // 여기서부터는 '정밀 계산' 구간 (기존 비트보드 로직)
    // 위 조건에 걸리지 않은 (즉, 결과가 아슬아슬한) 노드들만 이 아래를 실행함
    // ---------------------------------------------------------
    const materialDiff = totalBlackMaterial - totalWhiteMaterial;
    const globalScale = eval_weights.scalingParams?.globalPositionalWeight || 1.0;
    
    let score = baseScore;

    // 3. 동적 컨텍스트 계산 (스케일링)
    const advantageContext = Math.abs(materialDiff) / 10;
    const technicalScale = Math.max(0.1, 1.0 - (advantageContext * (eval_weights.scalingParams?.complexityReductionRate || 0.05)));
    const endgameContext = Math.max(0, 1.0 - (totalMaterial / 60));
    const pawnScale = 1.0 + (endgameContext * (eval_weights.scalingParams?.pawnEndgameIntensity || 1.0));

    // 4. 비트보드 기반 폰 평가 (루프 없음)
    const blackPawnStruct = evaluatePawnStructure(boardState, 'black', false)[0];
    const whitePawnStruct = evaluatePawnStructure(boardState, 'white', false)[0];
    score += (blackPawnStruct - whitePawnStruct) * technicalScale * globalScale;

    const blackPassed = evaluatePassedPawns(boardState, 'black', false)[0];
    const whitePassed = evaluatePassedPawns(boardState, 'white', false)[0];
    score += (blackPassed - whitePassed) * pawnScale * globalScale;

    // 5. 엔드게임 전용 보너스
    if (isEndgame) {
        score += (evaluateEndgameBonus(boardState, 'black', kingPos.black, kingPos.white, totalBlackMaterial, totalWhiteMaterial, false)[0] - 
                  evaluateEndgameBonus(boardState, 'white', kingPos.white, kingPos.black, totalWhiteMaterial, totalBlackMaterial, false)[0]) * globalScale;
    }

    // 흑색 턴 기준 점수이므로 그대로 반환 (이미 getPieceStaticScore에서 sign 처리됨)
    return [score, null];
};
