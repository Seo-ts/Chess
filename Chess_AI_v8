// [추가] TT의 압축된 수와 현재 move 객체를 비교
const isHashMove = (move, packedMove) => {
    if (!packedMove) return false;
    const fR = (packedMove >> 12) & 0x7, fC = (packedMove >> 9) & 0x7;
    const tR = (packedMove >> 6) & 0x7, tC = (packedMove >> 3) & 0x7;
    const spec = packedMove & 0x7;
    const moveSpec = move.to[2] === 'castling' ? 1 : (move.to[2] === 'enPassant' ? 2 : 0);
    return move.from[0] === fR && move.from[1] === fC && move.to[0] === tR && move.to[1] === tC && moveSpec === spec;
};

// 기존 getMovePriority 유지 + hashMove 파라미터 추가
const getMovePriority = (move, boardState, depth, hashMove) => {
    // 0순위: TT(Hash) Move - 이전 탐색에서 가장 좋았던 수
    if (isHashMove(move, hashMove)) return 2000000;

    let priority = 0;
    const targetPiece = boardState[move.to[0]][move.to[1]];

    // 1순위: MVV-LVA (Most Valuable Victim - Least Valuable Aggressor)
    if (targetPiece) {
        priority += 1000000 + (10 * pieceValues[targetPiece.toUpperCase()] - pieceValues[move.piece.toUpperCase()]);
    }

    // 2순위: Killer Moves
    if (killerMoves[depth]?.some(m => m.from[0] === move.from[0] && m.from[1] === move.from[1] && m.to[0] === move.to[0] && m.to[1] === move.to[1])) {
        priority += 500000;
    }

    // 3순위: History Heuristic
    const historyKey = `${move.piece}_${move.to[0]}_${move.to[1]}`;
    priority += historyTable[historyKey] || 0;

    // 4순위: Promotion boost
    if (move.piece.toUpperCase() === 'P' && (move.to[0] === 0 || move.to[0] === 7)) {
        priority += 100000;
    }
    
    // 5순위: 캐슬링
    if (move.to[2] === 'castling') {
        priority += 150000;
    }

    return priority;
};

// 기존 sortMoves 유지 + TT probe 연동
const sortMoves = (moves, boardState, depth) => {
    // 현재 국면의 Hash Move를 TT에서 조회
    const probe = tt.probe(currentBoardHash, 0, -Infinity, Infinity);
    const hashMove = probe ? probe.move : null;

    for (let i = 0; i < moves.length; i++) {
        moves[i].priority = getMovePriority(moves[i], boardState, depth, hashMove);
    }

    return moves.sort((a, b) => b.priority - a.priority);
};
