const simulateMove = (boardState, move) => {
    const newBoard = boardState.map(row => [...row]);
    const { from, to, piece } = move;
    const [toRow, toCol, special] = to;

    newBoard[toRow][toCol] = piece;
    newBoard[from[0]][from[1]] = null;

    if (special === 'enPassant') {
        newBoard[from[0]][toCol] = null;
    } else if (special === 'castling') {
        const rookFromCol = toCol === 6 ? 7 : 0;
        const rookToCol = toCol === 6 ? 5 : 3;
        newBoard[from[0]][rookToCol] = newBoard[from[0]][rookFromCol];
        newBoard[from[0]][rookFromCol] = null;
    }
    checkPromotionInternal(toRow, toCol, piece, newBoard);
    return newBoard;
};

// 현재 게임의 권한 상태들
let gameState = {
    castlingRights: { 
        whiteKingside: true, whiteQueenside: true, 
        blackKingside: true, blackQueenside: true 
    },
    enPassantSquare: null, // 앙파상이 가능한 타겟 칸 (예: {row: 2, col: 3})
    halfMoveClock: 0
};

///////////////////
function makeMove(board, move) {
    const { from, to, piece } = move;
    const [fR, fC] = from;
    const [tR, tC, special] = to;
    const isWhite = piece === piece.toUpperCase();
    const pIdx = pieceToIndex(piece);
    const fSq = fR * 8 + fC;
    const tSq = tR * 8 + tC;

    // --- [1] 상태 백업 ---
    move.prevHash = currentBoardHash;
    move.prevMGScore = currentMGScore;
    move.prevEGScore = currentEGScore;
    move.prevWhiteMaterial = totalWhiteMaterial; // 기물 가치 백업
    move.prevBlackMaterial = totalBlackMaterial;
    
    move.prevCastlingRights = JSON.parse(JSON.stringify(gameState.castlingRights));
    move.prevEnPassantSquare = gameState.enPassantSquare;
    move.prevHalfMoveClock = gameState.halfMoveClock;
    move.capturedPiece = board[tR][tC];
    move.prevKingPos = isWhite ? [...kingPos.white] : [...kingPos.black];
  
    if (gameState.castlingRights.whiteKingside)  currentBoardHash = (currentBoardHash ^ castleKeys[0]) & BB_MASK;
    if (gameState.castlingRights.whiteQueenside) currentBoardHash = (currentBoardHash ^ castleKeys[1]) & BB_MASK;
    if (gameState.castlingRights.blackKingside)  currentBoardHash = (currentBoardHash ^ castleKeys[2]) & BB_MASK;
    if (gameState.castlingRights.blackQueenside) currentBoardHash = (currentBoardHash ^ castleKeys[3]) & BB_MASK;
    if (gameState.enPassantSquare) currentBoardHash = (currentBoardHash ^ enPassantKeys[gameState.enPassantSquare.col]) & BB_MASK;

    // --- [2] 점수 업데이트 시작 ---
    
    // A. 이동하는 기물의 이전 위치 점수 제거
    const [mgFrom, egFrom] = getPieceStaticScore(piece, fR, fC);
    currentMGScore -= mgFrom;
    currentEGScore -= egFrom;

    // B. 목적지에 기물이 있다면(Capture) 해당 점수 및 기물 가치 제거
    if (move.capturedPiece) {
        const [mgCap, egCap] = getPieceStaticScore(move.capturedPiece, tR, tC);
        currentMGScore -= mgCap;
        currentEGScore -= egCap;
        
        const capVal = pieceValues[move.capturedPiece.toUpperCase()];
        if (isWhite) totalBlackMaterial -= capVal; // 백이 흑 기물을 잡음
        else totalWhiteMaterial -= capVal; // 흑이 백 기물을 잡음

        currentBoardHash = (currentBoardHash ^ zobristKeys[tR][tC][pieceToIndex(move.capturedPiece)]) & BB_MASK;
        // 비트보드 업데이트 (폰일 경우)
        if (move.capturedPiece === 'P') whitePawnsBB &= ~(1n << BigInt(tSq));
        else if (move.capturedPiece === 'p') blackPawnsBB &= ~(1n << BigInt(tSq));
    }

    // --- [3] 기물 실제 이동 및 특수 규칙 처리 ---
    board[fR][fC] = null;
    currentBoardHash = (currentBoardHash ^ zobristKeys[fR][fC][pIdx]) & BB_MASK; // 출발지 해시 제거

    let finalPiece = piece;
    const isPromotion = (piece === 'P' && tR === 0) || (piece === 'p' && tR === 7);

    if (isPromotion) {
        finalPiece = isWhite ? 'Q' : 'q';
        // 승급 시 기물 가치 변화 반영 (P -> Q)
        const promoDiff = pieceValues.Q - pieceValues.P;
        if (isWhite) totalWhiteMaterial += promoDiff;
        else totalBlackMaterial += promoDiff;
        
        // 비트보드에서는 출발지 폰만 지움 (목적지는 퀸이므로 안 킴)
        if (piece === 'P') whitePawnsBB &= ~(1n << BigInt(fSq));
        else blackPawnsBB &= ~(1n << BigInt(fSq));
    } else {
        // 일반 이동 시 비트보드 업데이트
        if (piece === 'P') {
            whitePawnsBB &= ~(1n << BigInt(fSq));
            whitePawnsBB |= (1n << BigInt(tSq));
        } else if (piece === 'p') {
            blackPawnsBB &= ~(1n << BigInt(fSq));
            blackPawnsBB |= (1n << BigInt(tSq));
        }
    }
    
    // C. 이동 후 새로운 위치의 점수 추가
    const [mgTo, egTo] = getPieceStaticScore(finalPiece, tR, tC);
    currentMGScore += mgTo;
    currentEGScore += egTo;

    board[tR][tC] = finalPiece;
    currentBoardHash = (currentBoardHash ^ zobristKeys[tR][tC][pieceToIndex(finalPiece)]) & BB_MASK;

    // D. 앙파상(En Passant) 특별 처리
    if (special === 'enPassant') {
        const capPawnRow = fR;
        const capPawnCol = tC;
        const capPawnSq = capPawnRow * 8 + capPawnCol;
        const capPawn = isWhite ? 'p' : 'P';
        
        const [mgEP, egEP] = getPieceStaticScore(capPawn, capPawnRow, capPawnCol);
        currentMGScore -= mgEP;
        currentEGScore -= egEP;
        
        const pVal = pieceValues.P;
        if (isWhite) totalBlackMaterial -= pVal;
        else totalWhiteMaterial -= pVal;

        currentBoardHash = (currentBoardHash ^ zobristKeys[capPawnRow][capPawnCol][pieceToIndex(capPawn)]) & BB_MASK;
        board[capPawnRow][capPawnCol] = null;
        
        if (isWhite) blackPawnsBB &= ~(1n << BigInt(capPawnSq));
        else whitePawnsBB &= ~(1n << BigInt(capPawnSq));
    }

    // E. 캐슬링(Castling) 특별 처리
    if (special === 'castling') {
        const rCol = (tC === 6) ? 7 : 0;
        const rDestCol = (tC === 6) ? 5 : 3;
        const rook = board[fR][rCol];

        const [mgR1, egR1] = getPieceStaticScore(rook, fR, rCol);
        const [mgR2, egR2] = getPieceStaticScore(rook, fR, rDestCol);
        currentMGScore = currentMGScore - mgR1 + mgR2;
        currentEGScore = currentEGScore - egR1 + egR2;

        currentBoardHash = (currentBoardHash ^ zobristKeys[fR][rCol][pieceToIndex(rook)]) & BB_MASK;
        currentBoardHash = (currentBoardHash ^ zobristKeys[fR][rDestCol][pieceToIndex(rook)]) & BB_MASK;
        board[fR][rDestCol] = board[fR][rCol];
        board[fR][rCol] = null;
    }

    // --- [4] 나머지 상태 업데이트 ---
    if (piece === 'K') {
        gameState.castlingRights.whiteKingside = false;
        gameState.castlingRights.whiteQueenside = false;
        kingPos.white = [tR, tC];
    } else if (piece === 'k') {
        gameState.castlingRights.blackKingside = false;
        gameState.castlingRights.blackQueenside = false;
        kingPos.black = [tR, tC];
    }
    
    updateCastlingRights(fR, fC);
    updateCastlingRights(tR, tC);

    if (piece.toUpperCase() === 'P' && Math.abs(fR - tR) === 2) {
        gameState.enPassantSquare = { row: (fR + tR) / 2, col: fC };
    } else {
        gameState.enPassantSquare = null;
    }

    // 권한 및 턴 해시 업데이트
    if (gameState.castlingRights.whiteKingside)  currentBoardHash = (currentBoardHash ^ castleKeys[0]) & BB_MASK;
    if (gameState.castlingRights.whiteQueenside) currentBoardHash = (currentBoardHash ^ castleKeys[1]) & BB_MASK;
    if (gameState.castlingRights.blackKingside)  currentBoardHash = (currentBoardHash ^ castleKeys[2]) & BB_MASK;
    if (gameState.castlingRights.blackQueenside) currentBoardHash = (currentBoardHash ^ castleKeys[3]) & BB_MASK;
    if (gameState.enPassantSquare) currentBoardHash = (currentBoardHash ^ enPassantKeys[gameState.enPassantSquare.col]) & BB_MASK;

    currentBoardHash = (currentBoardHash ^ turnKey) & BB_MASK;

    if (piece.toUpperCase() === 'P' || move.capturedPiece) gameState.halfMoveClock = 0;
    else gameState.halfMoveClock++;
}

function unmakeMove(board, move) {
    // 1. 해시 및 모든 점수, 기물 가치 복원
    currentBoardHash = move.prevHash;
    currentMGScore = move.prevMGScore;
    currentEGScore = move.prevEGScore;
    totalWhiteMaterial = move.prevWhiteMaterial;
    totalBlackMaterial = move.prevBlackMaterial;

    gameState.castlingRights = move.prevCastlingRights;
    gameState.enPassantSquare = move.prevEnPassantSquare;
    gameState.halfMoveClock = move.prevHalfMoveClock;

    // 2. 기물 위치 복원
    const [fR, fC] = move.from;
    const [tR, tC, special] = move.to;
    const piece = move.piece;
    const capturedPiece = move.capturedPiece;
    const fSq = fR * 8 + fC;
    const tSq = tR * 8 + tC;
    const isWhite = piece === piece.toUpperCase();

    board[fR][fC] = piece;
    board[tR][tC] = capturedPiece;

    if (piece === 'K') kingPos.white = move.prevKingPos;
    else if (piece === 'k') kingPos.black = move.prevKingPos;

    // 3. 비트보드 복원 (폰 이동)
    if (piece === 'P') {
        whitePawnsBB |= (1n << BigInt(fSq));
        whitePawnsBB &= ~(1n << BigInt(tSq));
    } else if (piece === 'p') {
        blackPawnsBB |= (1n << BigInt(fSq));
        blackPawnsBB &= ~(1n << BigInt(tSq));
    }

    // 4. 비트보드 복원 (잡혔던 폰)
    if (capturedPiece === 'P') whitePawnsBB |= (1n << BigInt(tSq));
    else if (capturedPiece === 'p') blackPawnsBB |= (1n << BigInt(tSq));

    // 5. 앙파상 복원
    if (special === 'enPassant') {
        const capPawnRow = fR;
        const capPawnCol = tC;
        const capPawnSq = capPawnRow * 8 + capPawnCol;
        board[capPawnRow][capPawnCol] = isWhite ? 'p' : 'P';
        if (isWhite) blackPawnsBB |= (1n << BigInt(capPawnSq));
        else whitePawnsBB |= (1n << BigInt(capPawnSq));
    }

    // 6. 캐슬링 복원
    if (special === 'castling') {
        const rCol = (tC === 6) ? 7 : 0;
        const rDestCol = (tC === 6) ? 5 : 3;
        board[fR][rCol] = board[fR][rDestCol];
        board[fR][rDestCol] = null;
    }
}

/**
 * 실제로 기물을 움직이지 않고 턴만 넘깁니다. (NMP용)
 */
function makeNullMove() {
    // 1. 현재 상태 백업 (unmake를 위함)
    const prevData = {
        hash: currentBoardHash,
        enPassant: gameState.enPassantSquare,
        halfMove: gameState.halfMoveClock
    };

    // 2. 해시 업데이트: 기존 앙파상 권한 제거 (앙파상은 바로 다음 차례에만 유효하므로)
    if (gameState.enPassantSquare) {
        currentBoardHash = (currentBoardHash ^ enPassantKeys[gameState.enPassantSquare.col]) & BB_MASK;
    }

    // 3. 해시 업데이트: 턴 교체
    currentBoardHash = (currentBoardHash ^ turnKey) & BB_MASK;

    // 4. 게임 상태 업데이트
    gameState.enPassantSquare = null;
    gameState.halfMoveClock++;

    return prevData; // 백업 데이터 반환
}

/**
 * Null Move를 취소하고 이전 상태로 복구합니다.
 */
function unmakeNullMove(prevData) {
    currentBoardHash = prevData.hash;
    gameState.enPassantSquare = prevData.enPassant;
    gameState.halfMoveClock = prevData.halfMove;
}
