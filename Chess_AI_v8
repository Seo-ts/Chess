// 탐색된 총 노드 수를 저장할 변수 (함수 외부에 선언하거나 aiMove 시작 시 초기화)
let nodesVisited = 0; 

const searchAtDepth = (depth, legalMoves, isAiMaximizing, phase, hStr, isExploring, prevScore) => {
    // 엔드게임이나 기물 차이가 클 때는 변동폭이 크므로 윈도우를 조금 더 넓게 잡음 (0.5 -> 1.0)
    const WINDOW = (totalWhiteMaterial + totalBlackMaterial < 20) ? 0.5 : 0.5;
    const MAX_RETRIES = 4;
    const MATE_THRESHOLD = 4500;
    const useWindow = (depth >= 3) && (prevScore !== null) && (Math.abs(prevScore) < MATE_THRESHOLD);

    const runSearch = (alpha, beta) => {
        let allScores = [];
        let bestFound = isAiMaximizing ? -Infinity : Infinity;
        let failType = null;

        for (const move of legalMoves) {
            makeMove(internalBoardState, move);
            let [score, details] = alphaBeta(internalBoardState, depth - 1, alpha, beta, !isAiMaximizing, 1, false, depth);
            unmakeMove(internalBoardState, move);

            if (phase === 'endgame') {
                const moveKey = `${move.from[0]}${move.from[1]}${move.to[0]}${move.to[1]}`;
                let weight = (learningDB[hStr]?.[moveKey])?.[0] || 0;
                if (!isExploring) score += isAiMaximizing ? weight : -weight;
            }

            allScores.push({ move, score, searchDetails: details });

            if (isAiMaximizing) {
                if (score > bestFound) bestFound = score;
                if (score >= beta) { failType = 'high'; break; }
            } else {
                if (score < bestFound) bestFound = score;
                if (score <= alpha) { failType = 'low'; break; }
            }
        }
        return { allScores, bestFound, failType };
    };

    if (!useWindow) {
        const res = runSearch(-Infinity, Infinity);
        return { moveScores: res.allScores, bestScore: res.bestFound };
    }

    let alpha = prevScore - WINDOW;
    let beta = prevScore + WINDOW;

    for (let attempt = 0; attempt < MAX_RETRIES; attempt++) {
        // 재탐색 전 TT 오염 방지 (현재 깊이의 루트 엔트리 무효화)
        tt.store(currentBoardHash, 0, depth, TT_EXACT, null);
        
        const res = runSearch(alpha, beta);

        // 메이트 점수 발견 시 창 확장 중단 및 풀 창 탐색으로 전환
        if (Math.abs(res.bestFound) >= MATE_THRESHOLD) break;

        if (res.failType === 'low') {
            alpha -= WINDOW * Math.pow(4, attempt + 1); // 더 빠르게 확장
        } else if (res.failType === 'high') {
            beta += WINDOW * Math.pow(4, attempt + 1);
        } else {
            return { moveScores: res.allScores, bestScore: res.bestFound };
        }
    }

    tt.store(currentBoardHash, 0, depth, TT_EXACT, null);
    const fallback = runSearch(-Infinity, Infinity);
    return { moveScores: fallback.allScores, bestScore: fallback.bestFound };
};

const aiMove = () => {
