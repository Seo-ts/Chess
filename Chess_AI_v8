const initGameHash = () => {
    let hash = 0n;
    for (let r = 0; r < 8; r++) {
        for (let c = 0; c < 8; c++) {
            const piece = internalBoardState[r][c];
            if (piece) {
                // ✅ 모든 XOR 연산에 마스킹 적용
                hash = (hash ^ zobristKeys[r][c][pieceToIndex(piece)]) & BB_MASK;
            }
        }
    }
    if (currentTurn === 'black') hash = (hash ^ turnKey) & BB_MASK;

    if (gameState.castlingRights.whiteKingside)  hash = (hash ^ castleKeys[0]) & BB_MASK;
    if (gameState.castlingRights.whiteQueenside) hash = (hash ^ castleKeys[1]) & BB_MASK;
    if (gameState.castlingRights.blackKingside)  hash = (hash ^ castleKeys[2]) & BB_MASK;
    if (gameState.castlingRights.blackQueenside) hash = (hash ^ castleKeys[3]) & BB_MASK;

    if (gameState.enPassantSquare) {
        hash = (hash ^ enPassantKeys[gameState.enPassantSquare.col]) & BB_MASK;
    }
    currentBoardHash = hash & BB_MASK;
};
