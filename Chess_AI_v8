/**
 * 현재 차례의 플레이어가 폰을 제외한 기물(나이트, 비숍 등)을 가지고 있는지 확인
 */
function hasNonPawnMaterial(isBlack) {
    // 이미 실시간으로 업데이트 중인 재료 변수 사용 (매우 빠름)
    const material = isBlack ? totalBlackMaterial : totalWhiteMaterial;
    
    // 폰은 개당 1점입니다. 기물이 있다면 보통 폰 점수보다 높습니다.
    // 또는 비트보드로 더 정확히 체크할 수 있습니다.
    // 간단하게: 현재 재료 점수가 폰(최대 8개)의 가치보다 높으면 기물이 있는 것임.
    return material > 8; 
}

const alphaBeta = (boardState, depth, alpha, beta, maximizingPlayer, ply = 0, isCheck = false, initialDepth) => {
    nodesVisited++;
    if (initialDepth === undefined) initialDepth = depth;

    // 1. 무승부 체크 (문자열 변환은 여기서 딱 한 번만 수행)
    //const hStr = currentBoardHash.toString();
    const historyCount = positionHistory.get(currentBoardHash) || 0;
    const isRepetition = historyCount + (searchStackHashes.filter(h => h === currentBoardHash).length) >= 2;
    
    if (isRepetition || gameState.halfMoveClock >= 99) {
        return [handleDrawScore(boardState, maximizingPlayer, ply), {}];
    }
  
    /////////////순서 변경////
    // 2. TT 조회 (전역 BigInt 해시 사용)
    const ttEntry = tt.probe(currentBoardHash, depth, alpha, beta);
    // 정확한 점수가 있으면 즉시 반환
    if (ttEntry && ttEntry.score !== null) return [ttEntry.score, {}];
  
    const phase = getGamePhase();
    const staticEval = (phase === 'endgame') ? currentEGScore : currentMGScore;
  
    // [RFP: Reverse Futility Pruning]
    if (depth <= 4 && !isCheck && ply > 0) {
        rfpAttempts++; // 시도 횟수 기록

        const margin = 1.0 * depth;//ai가 멍청하면 1.5로 상향

        if (staticEval - margin >= beta) {
            rfpPruned++; // 가지치기 성공 기록
            return [staticEval, {}]; 
        }
    }
  
    // [NMP: Null Move Pruning]
    if (phase !== 'endgame' && depth >= 4 && !isCheck && ply > 0 && staticEval >= beta && hasNonPawnMaterial(maximizingPlayer)) {
        nmpAttempts++;

        const R = 2; 
      
        const nullData = makeNullMove();

        const [nullScore] = alphaBeta(boardState, depth - 1 - R, -beta, -beta + 1, !maximizingPlayer, ply + 1, false, initialDepth);

        // 쉬었던 한 수를 복구합니다.
        unmakeNullMove(nullData);

        // 한 수를 쉬었는데도 상대의 기대치(Beta)보다 내 점수가 높게 나온다면?
        // 이 경로는 너무 유리해서 더 볼 필요가 없습니다.
        if (maximizingPlayer ? nullScore >= beta : nullScore <= alpha) {
            nmpPruned++;
            return [maximizingPlayer ? beta : alpha, {}]; // 즉시 컷오프
        }
    }
    //////////////

    const color = maximizingPlayer ? 'black' : 'white';
    const legalMoves = getLegalMoves(boardState, color);

    if (legalMoves.length === 0) {
        if (isInCheck(color, boardState)) {
            return [maximizingPlayer ? -100000 + ply : 100000 - ply, {}];
        }
        return [handleDrawScore(boardState, maximizingPlayer, ply), {}];
    }

    // 체크 연장(Extension)
    let extension = (isCheck && ply < initialDepth + 2) ? 1 : 0;

    if (depth <= 0 && extension === 0) {
        return quiescenceSearch(boardState, alpha, beta, maximizingPlayer);
    }

    // TT에서 가져온 이동 정보를 sortMoves에 전달
    const hashMove = ttEntry ? ttEntry.move : null;
    const sortedMoves = sortMoves(legalMoves, boardState, ply, hashMove);

    searchStackHashes.push(currentBoardHash); 
    let bestScore = maximizingPlayer ? -Infinity : Infinity;
    let bestMoveInThisNode = null; // 실제 Alpha/Beta를 갱신한 이동 저장

    for (let i = 0; i < sortedMoves.length; i++) {
    const move = sortedMoves[i];
    const movesSearched = i + 1; // 현재 몇 번째 수를 보고 있는가

    makeMove(boardState, move);
    
    // 상대방이 체크가 되는지는 makeMove 후에 판단 (이건 어쩔 수 없이 체크해야 함)
    const nextIsCheck = isInCheck(maximizingPlayer ? 'white' : 'black', boardState);

    let score;

    // --- [최적화된 LMR 판단] ---
    // 1. 뎁스가 3 이상이어야 함
    // 2. 이미 sortMoves에서 결정된 상위권(보통 1~3순위)은 무조건 풀 탐색
    // 3. priority가 전술적 기준선(500,000)보다 낮아야 함 (즉, 평범한 수)
    // 4. 상대를 체크하는 수가 아니어야 함
    // 5. 내가 현재 체크 상태가 아니어야 함
    
    const isQuietMove = move.priority < 500000; 
    const isTopRank = movesSearched <= 3; //상위 n개 정밀 탐색

    if (depth >= 4 && !isTopRank && isQuietMove && !nextIsCheck && !isCheck) {
        lmrAttempts++; // 감쇄 탐색 시도 카운트
        // 1~2단계 감쇄 탐색
        const reduction = (depth >= 6 && movesSearched > 10) ? 2 : 1;
        [score] = alphaBeta(boardState, depth - 1 - reduction, alpha, beta, !maximizingPlayer, ply + 1, nextIsCheck, initialDepth);
        
        // 결과가 좋으면 다시 정밀 탐색
        if (maximizingPlayer ? score > alpha : score < beta) {
            lmrResearches++; // 재탐색 카운트
            [score] = alphaBeta(boardState, depth - 1, alpha, beta, !maximizingPlayer, ply + 1, nextIsCheck, initialDepth);
        }
    } else {
        // 전술적이거나 상위권인 수는 무조건 풀 탐색
        [score] = alphaBeta(boardState, depth - 1, alpha, beta, !maximizingPlayer, ply + 1, nextIsCheck, initialDepth);
    }

    unmakeMove(boardState, move);

        if (maximizingPlayer) {
            if (score > bestScore) {
                bestScore = score;
                bestMoveInThisNode = move; // 여기서 베스트 무브 업데이트
            }
            alpha = Math.max(alpha, score);
        } else {
            if (score < bestScore) {
                bestScore = score;
                bestMoveInThisNode = move; // 여기서 베스트 무브 업데이트
            }
            beta = Math.min(beta, score);
        }

        if (beta <= alpha) {
            // Cut-off 발생 시 이 수가 가장 강력한 수임
            tt.store(currentBoardHash, bestScore, depth, TT_LOWERBOUND, move);
            recordKillerMove(move, ply, depth, boardState);
            searchStackHashes.pop();
            return [bestScore, {}];
        }
    }
    
    searchStackHashes.pop();

    // 4. TT 최종 저장
    let ttFlag = TT_EXACT;
    if (bestScore <= alpha) ttFlag = TT_UPPERBOUND;
    else if (bestScore >= beta) ttFlag = TT_LOWERBOUND;

    tt.store(currentBoardHash, bestScore, depth, ttFlag, bestMoveInThisNode);

    return [bestScore, {}];
};
