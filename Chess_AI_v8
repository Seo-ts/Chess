// [완전 수정] TT 설정
const TT_SIZE = 1 << 19; 
const TT_MASK = TT_SIZE - 1;

const TT_EXACT = 0;
const TT_LOWERBOUND = 1;
const TT_UPPERBOUND = 2;

class TranspositionTable {
    constructor(size) {
        this.size = size;
        // 64비트 전체 해시를 저장하기 위한 BigUint64Array
        this.hashTableKey = new BigUint64Array(size); 
        this.data = new Int32Array(size);
        this.bestMove = new Uint32Array(size);
    }

    getIndex(hash) {
        return Number(BigInt(hash) & BigInt(TT_MASK));
    }

    store(hash, score, depth, flag, move) {
        const h = BigInt(hash);
        const idx = this.getIndex(h);
        const existingDepth = (this.data[idx] >> 8) & 0xFF;

        // 깊이 우선 교체 정책
        if (this.hashTableKey[idx] === 0n || existingDepth <= depth) {
            this.hashTableKey[idx] = h;
            const scoreInt = Math.round(score);
            this.data[idx] = (scoreInt << 16) | (depth << 8) | flag;
            
            if (move) {
                const spec = move.to[2] === 'castling' ? 1 : (move.to[2] === 'enPassant' ? 2 : 0);
                this.bestMove[idx] = (move.from[0] << 12) | (move.from[1] << 9) | (move.to[0] << 6) | (move.to[1] << 3) | spec;
            } else {
                this.bestMove[idx] = 0;
            }
        }
    }

    probe(hash, depth, alpha, beta) {
        const h = BigInt(hash);
        const idx = this.getIndex(h);

        if (this.hashTableKey[idx] === h) {
            const entry = this.data[idx];
            const entryDepth = (entry >> 8) & 0xFF;
            
            if (entryDepth >= depth) {
                const flag = entry & 0xFF;
                const score = entry >> 16;
                if (flag === TT_EXACT) return { score, move: this.bestMove[idx] };
                if (flag === TT_UPPERBOUND && score <= alpha) return { score: alpha, move: this.bestMove[idx] };
                if (flag === TT_LOWERBOUND && score >= beta) return { score: beta, move: this.bestMove[idx] };
            }
            return { score: null, move: this.bestMove[idx] };
        }
        return null;
    }

    // [추가] 유효 엔트리 개수 계산
    getEntryCount() {
        let count = 0;
        for (let i = 0; i < this.size; i++) {
            // BigInt이므로 0n과 비교해야 합니다.
            if (this.hashTableKey[i] !== 0n) {
                count++;
            }
        }
        return count;
    }

    // [추가] 사용률 계산
    getFillRate() {
        const count = this.getEntryCount();
        return ((count / this.size) * 100).toFixed(4);
    }

    clear() {
        this.hashTableKey.fill(0n);
        this.data.fill(0);
        this.bestMove.fill(0);
    }
}

