function tuneWeights(moveEntry, moveIndex) {
    if (!isSelfTuningEnabled || !moveEntry.staticDetails) return;

    const teacher = moveEntry.evalScore;   // Search 전체 점수 (단위: pawn)
    const student = moveEntry.staticScore; // Static 전체 점수 (단위: pawn)
    const details = moveEntry.staticDetails;

    // --- [NEW] 1. 시그모이드 승률 변환 ---
    // 점수를 0~1 사이의 승률로 변환하여 점수 인플레이션을 방지합니다.
    // K=4.0은 400cp(폰 4개) 차이가 날 때 승률이 약 90%가 됨을 의미합니다.
    // 가중치가 높다면 K값 낮추기 3.0
    const K = 4.0;
    const sigmoid = (s) => 1 / (1 + Math.pow(10, -s / K));
    
    const teacherWinProb = sigmoid(teacher);
    const studentWinProb = sigmoid(student);
    
    // 승률 오차 (Win Probability Error)
    // 이제 에러는 아무리 커도 1.0(완전 패배 -> 완전 승리)을 넘을 수 없습니다.
    let globalError = teacherWinProb - studentWinProb;

    // 미세 오차 무시 (0.01% 미만의 승률 차이는 조정하지 않음)
    if (Math.abs(globalError) < 0.0001) return;

    // --- 2. 학습 설정 ---
    const lr = 0.05;         // 승률 기반이므로 학습률을 기존보다 높게 설정 (0.002 -> 0.05)
    const lrScale = 0.01;    // 스케일링 파라미터용 학습률
    const REG_DECAY = 0.0001; // L2 규제 (Weight Decay): 가중치가 너무 커지지 않게 뒤로 당기는 힘

    for (let key in details) {
        const rawFeature = details[key].feature;
        if (rawFeature === 0) continue;

        // --- [A] 스케일링 파라미터 튜닝 (부호 기반 방향성 학습) ---
        if (key.startsWith('scalingParams_')) {
            const paramName = key.split('_')[1];
            if (eval_weights.scalingParams.hasOwnProperty(paramName)) {
                const featureDir = Math.sign(rawFeature);
                // 스케일링 파라미터는 시스템의 틀이므로 규제를 적용하지 않거나 아주 미세하게 적용
                let updateAmount = globalError * featureDir * lrScale;

                const oldVal = eval_weights.scalingParams[paramName];
                eval_weights.scalingParams[paramName] = Math.max(0.01, Math.min(5.0, oldVal + updateAmount));
            }
            continue;
        }

        // --- [B] 일반 가중치 튜닝 (정규화된 크기 기반 비중 학습) ---
        
        // 피처 정규화 적용 (NORM_FACTORS는 기존 동일)
        let normFactor = NORM_FACTORS.default;
        if (key.startsWith('mobility_')) normFactor = NORM_FACTORS.mobility;
        else if (key.includes('Pawn')) normFactor = NORM_FACTORS.pawnStructure;
        else if (key.includes('passed')) normFactor = NORM_FACTORS.passedPawns;
        else if (key.endsWith('_pst_w')) normFactor = NORM_FACTORS.pst; // [추가] PST 가중치 정규화
        
        const normalizedFeature = rawFeature / normFactor;

        // [핵심] 가중치 업데이트 공식 (L2 Regularization 포함)
        // 가중치가 커질수록 REG_DECAY에 의해 0 방향으로 돌아가려는 힘이 강해집니다.
        let oldWeight = 0;
        let keyTarget = null;
        let subKey = null;

        if (key.startsWith('mobility_')) {
            subKey = key.split('_')[1];
            keyTarget = eval_weights.mobility;
            oldWeight = keyTarget[subKey];
        } else if (key.startsWith('passedPawnRankBonus_')) {
            subKey = parseInt(key.split('_')[1]);
            keyTarget = eval_weights.passedPawnRankBonus;
            oldWeight = keyTarget[subKey];
        } else if (typeof eval_weights[key] === 'number') {
            // [대응] knight_pst_w, bishop_pst_w 등 top-level 가중치들
            keyTarget = eval_weights;
            subKey = key;
            oldWeight = keyTarget[subKey];
        }

        if (keyTarget && subKey !== null) {
            // 업데이트량 = (승률 에러 * 정규화 피처 * 학습률) - (현재 가중치 * 규제 강도)
            let delta = (globalError * normalizedFeature * lr) - (oldWeight * REG_DECAY);
            
            // PST 가중치는 보통 1.0 근처에서 움직이므로 범위를 적절히 제한 (0.1 ~ 3.0)
            let minBound = 0.0;
            let maxBound = 2.0;

            if (key.endsWith('_pst_w')) {
                minBound = 0.1; 
                maxBound = 3.0;
            } else if (key.startsWith('passedPawnRankBonus_')) {
                maxBound = 20.0;
            }
            
            keyTarget[subKey] = Math.max(minBound, Math.min(maxBound, oldWeight + delta));
        }
    }
}
