const evaluateEndgameBonus = (boardState, color, myKing, oppKing, myMaterial, oppMaterial, isTuning) => {
    let totalScore = 0;
    // tuning 모드일 때만 빈 객체를 생성하고, 아니면 null로 둡니다.
    let details = isTuning ? {} : null; 
    
    const isWhite = color === 'white';
    
    if (myMaterial > oppMaterial + 2) {
        if (!myKing || !oppKing) return [0, isTuning ? {} : null];

        // (A) 상대 킹을 구석으로 몰기
        const distFromCenterVal = Math.abs(oppKing[0] - 3.5) + Math.abs(oppKing[1] - 3.5);
        const distFromCenterScore = distFromCenterVal * eval_weights.oppDistFromCenter_w;
        totalScore += distFromCenterScore;

        if (isTuning) { // 튜닝 모드일 때만 상세 데이터 기록
            details['oppDistFromCenter_w'] = {
                score: distFromCenterScore,
                feature: distFromCenterVal
            };
        }

        // (B) 우리 킹과 상대 킹의 거리 좁히기
        const kingDistVal = 14 - (Math.abs(myKing[0] - oppKing[0]) + Math.abs(myKing[1] - oppKing[1]));
        const kingDistScore = kingDistVal * eval_weights.distBetweenKings_w;
        totalScore += kingDistScore;

        if (isTuning) {
            details['distBetweenKings_w'] = {
                score: kingDistScore,
                feature: kingDistVal
            };
        }
        
        // (C) 상대 킹의 이동성 제한
        const oppKingMovesRaw = getValidMoves_Raw(isWhite ? 'k' : 'K', oppKing[0], oppKing[1], boardState);
        const restrictionVal = 8 - oppKingMovesRaw.length;
        const restrictionScore = restrictionVal * eval_weights.oppKingMoves_w;
        totalScore += restrictionScore;

        if (isTuning) {
            details['oppKingMoves_w'] = {
                score: restrictionScore,
                feature: restrictionVal
            };
        }
    }
    
    return [totalScore, details];
};

const getMaterialScore = (boardState, color, isTuning) => {
    let totalScore = 0;
    // 기물 가치는 고정(Fixed)이므로 details 객체는 비워둡니다.
    let details = {}; 
    
    const isWhite = color === 'white';
    
    for (let row = 0; row < 8; row++) {
        for (let col = 0; col < 8; col++) {
            const piece = boardState[row][col];
            if (piece) {
                const pieceIsWhite = piece === piece.toUpperCase();
                if (pieceIsWhite === isWhite) {
                    const pUpper = piece.toUpperCase();
                    // pieceValues에서 정의된 상수를 그대로 사용
                    totalScore += pieceValues[pUpper];
                }
            }
        }
    }
    
    // [총점, {}] 형태로 반환하여 튜닝 엔진이 무시하게 함
    return [totalScore, isTuning ? details : null];
};

// 파일별 마스크 (A~H열)
const FILE_MASKS = Array(8).fill(0n).map((_, c) => {
    let mask = 0n;
    for (let r = 0; r < 8; r++) mask |= (1n << BigInt(r * 8 + c));
    return mask;
});

// 인접 파일 마스크 (예: B열의 경우 A+C열)
const ADJ_FILE_MASKS = Array(8).fill(0n).map((_, c) => {
    let mask = 0n;
    if (c > 0) mask |= FILE_MASKS[c - 1];
    if (c < 7) mask |= FILE_MASKS[c + 1];
    return mask;
});

const evaluatePawnStructure = (boardState, color, isTuning = false) => {
    const isWhite = color === 'white';
    const myPawns = (isWhite ? whitePawnsBB : blackPawnsBB) & 0xFFFFFFFFFFFFFFFFn;
    const weights = eval_weights;
    
    let totalScore = 0;
    let details = isTuning ? {} : null;

    // 1. 겹친 폰 (Doubled) - 루프 없음
    const doubled = myPawns & (isWhite ? (myPawns << 8n) : (myPawns >> 8n));
    const dCount = popcount64(doubled);
    if (dCount > 0) {
        const score = dCount * weights.doubledPawn_w;
        totalScore -= score;
        if (isTuning) details['doubledPawn_w'] = { score: -score, feature: -dCount };
    }

    // 2. 고립된 폰 (Isolated) - 루프 제거 (Pawn Fill 방식)
    // 모든 폰의 좌우 파일에 폰이 하나라도 있는지 한 번에 계산
    const neighbors = ((myPawns << 1n) & 0xFEFEFEFEFEFEFEFEn) | ((myPawns >> 1n) & 0x7F7F7F7F7F7F7F7Fn);
    
    // [설명] '내 폰 위치'에 '좌우 파일 폰들의 그림자'가 투영되지 않았다면 그 폰은 고립된 것임
    // 하지만 파일 전체를 가려야 하므로 파일 마스크를 씌운 neighbors와의 비교가 필요함
    // 아래는 성능 최적화된 고립 폰 판정입니다.
    let isoCount = 0;
    // 고립된 폰은 파일 단위 연산이 가장 정확하므로 8번의 단순 마스킹 연산만 수행
    for (let c = 0; c < 8; c++) {
        const filePawns = myPawns & FILE_MASKS[c];
        if (filePawns && !(myPawns & ADJ_FILE_MASKS[c])) {
            isoCount += popcount64(filePawns);
        }
    }
    if (isoCount > 0) {
        const score = isoCount * weights.isolatedPawn_w;
        totalScore -= score;
        if (isTuning) details['isolatedPawn_w'] = { score: -score, feature: -isoCount };
    }

    // 3. 폰 팔랑크스 & 체인 (Vectorized)
    const phalanx = myPawns & ((myPawns << 1n) & 0xFEFEFEFEFEFEFEFEn);
    const pCount = popcount64(phalanx);
    
    let supported;
    if (isWhite) {
        supported = myPawns & (((myPawns << 9n) & 0xFEFEFEFEFEFEFEFEn) | ((myPawns << 7n) & 0x7F7F7F7F7F7F7F7Fn));
    } else {
        supported = myPawns & (((myPawns >> 7n) & 0xFEFEFEFEFEFEFEFEn) | ((myPawns >> 9n) & 0x7F7F7F7F7F7F7F7Fn));
    }
    const sCount = popcount64(supported);

    totalScore += (pCount * weights.phalanx_w) + (sCount * weights.pawnChain_w);

    if (isTuning) {
        details['phalanx_w'] = { score: pCount * weights.phalanx_w, feature: pCount };
        details['pawnChain_w'] = { score: sCount * weights.pawnChain_w, feature: sCount };
    }

    return [totalScore, details];
};

function getLSB(bb) {
    if (bb === 0n) return -1;

    // 1. 가장 하위 비트 하나만 남기기 (Isolate LSB)
    const val = bb & -bb;

    // 2. 하위 32비트 추출해서 검사
    const low = Number(val & 0xFFFFFFFFn);
    
    if (low !== 0) {
        // 하위 32비트에 비트가 있다면: 
        // 31 - (앞쪽 0의 개수) = 비트의 인덱스
        return 31 - Math.clz32(low);
    } else {
        // 하위 32비트가 비어있다면 상위 32비트 검사
        const high = Number(val >> 32n);
        // 상위 비트의 인덱스에 32를 더함
        return 63 - Math.clz32(high);
    }
}

const WHITE_PASSED_MASKS = new BigUint64Array(64);
const BLACK_PASSED_MASKS = new BigUint64Array(64);

function initPassedPawnMasks() {
    for (let sq = 0; sq < 64; sq++) {
        let r = Math.floor(sq / 8);
        let c = sq % 8;
        
        let wMask = 0n;
        let bMask = 0n;

        // 전방(White는 위, Black은 아래) 및 인접 파일 체크
        for (let checkRow = 0; checkRow < 8; checkRow++) {
            for (let checkCol = Math.max(0, c - 1); checkCol <= Math.min(7, c + 1); checkCol++) {
                let checkSq = checkRow * 8 + checkCol;
                if (checkRow < r) wMask |= (1n << BigInt(checkSq)); // 백색 폰 기준 위쪽
                if (checkRow > r) bMask |= (1n << BigInt(checkSq)); // 흑색 폰 기준 아래쪽
            }
        }
        WHITE_PASSED_MASKS[sq] = wMask;
        BLACK_PASSED_MASKS[sq] = bMask;
    }
}
initPassedPawnMasks(); // 초기화 실행

const evaluatePassedPawns = (boardState, color, isTuning = false) => {
    const isWhite = color === 'white';
    
    // 1. 64비트 제한 및 조기 종료 처리
    let myPawns = (isWhite ? whitePawnsBB : blackPawnsBB) & 0xFFFFFFFFFFFFFFFFn;
    if (myPawns === 0n) return [0, isTuning ? {} : null];

    const oppPawns = (isWhite ? blackPawnsBB : whitePawnsBB) & 0xFFFFFFFFFFFFFFFFn;
    const masks = isWhite ? WHITE_PASSED_MASKS : BLACK_PASSED_MASKS;
    const rankBonuses = eval_weights.passedPawnRankBonus;

    let totalScore = 0;
    let details = isTuning ? {} : null;

    // 2. 비트 순회 최적화
    while (myPawns !== 0n) {
        // LSB 찾기 (이미 교체한 고속 getLSB 사용)
        const sq = getLSB(myPawns);
        if (sq === -1) break;

        // 3. 패스드 폰 판정 (비트 연산)
        if ((masks[sq] & oppPawns) === 0n) {
            // sq >> 3 은 Math.floor(sq / 8) 보다 빠릅니다.
            const rank = isWhite ? (7 - (sq >> 3)) : (sq >> 3);
            const weight = rankBonuses[rank];
            totalScore += weight;

            if (isTuning) {
                const key = `passedPawnRankBonus_${rank}`;
                if (!details[key]) details[key] = { score: 0, feature: 0 };
                details[key].score += weight;
                details[key].feature += 1;
            }
        }

        // 4. [핵심 최적화] 가장 하위 비트(LSB)를 단 한 번의 연산으로 제거
        // BigInt 객체 생성을 최소화하여 NPS를 크게 올립니다.
        myPawns &= (myPawns - 1n);
    }

    return [totalScore, details];
};

const getDynamicPieceValue = (piece, row, col, totalMaterial, isTuning = false) => {
    if (!piece) return [0, isTuning ? {} : null];

    const pUpper = piece.toUpperCase();
    const isWhite = piece === pUpper;
    let totalValue = pieceValues[pUpper];
    let details = isTuning ? {} : null; 
    
    // 폰일 경우에만 동적 가치(통과한 폰 보너스)를 계산
    if (pUpper === 'P') {
        // [최적화] 엔드게임 진행도 계산
        const endgameProgress = Math.max(0.0001, Math.min(1, 1.0 - (totalMaterial / 60)));
        
        const rankIndex = isWhite ? (7 - row) : row;
        const baseBonus = eval_weights.passedPawnRankBonus[rankIndex];
        
        // 보너스에 진행도를 곱하여 스무스하게 적용
        const smoothedBonus = baseBonus * endgameProgress;
        totalValue += smoothedBonus;
        
        if (isTuning) {
            const key = `passedPawnRankBonus_${rankIndex}`;
            details[key] = {
                score: smoothedBonus,
                feature: endgameProgress
            };
        }
    }
    
    return [totalValue, details];
};

const isPiecePinned = (boardState, r, c, color, kingPos) => {
    if (!kingPos) return false;

    const kr = kingPos[0];
    const kc = kingPos[1];
    const dr = r - kr;
    const dc = c - kc;

    // 1. 수직, 수평, 대각선 라인에 있는지 확인
    const absDr = dr < 0 ? -dr : dr;
    const absDc = dc < 0 ? -dc : dc;

    if (dr === 0 || dc === 0 || absDr === absDc) {
        // 방향 벡터 계산 (Math.sign 대신 조건문이 미세하게 빠름)
        const stepR = dr === 0 ? 0 : (dr > 0 ? 1 : -1);
        const stepC = dc === 0 ? 0 : (dc > 0 ? 1 : -1);

        let currR = r + stepR;
        let currC = c + stepC;
        const isWhite = color === 'white';

        // 기물 너머로 상대방의 원거리 기물이 있는지 확인
        while (currR >= 0 && currR < 8 && currC >= 0 && currC < 8) {
            const p = boardState[currR][currC];
            if (p) {
                const pUpper = p.toUpperCase();
                const isOpponent = isWhite ? (p !== pUpper) : (p === pUpper);
                
                if (isOpponent) {
                    // 상대 퀸, 혹은 라인에 맞는 룩/비숍이 있으면 핀
                    if (pUpper === 'Q') return true;
                    if ((dr === 0 || dc === 0) && pUpper === 'R') return true;
                    if (absDr === absDc && pUpper === 'B') return true;
                }
                break; // 어떤 기물이든 만나면 그 너머는 볼 필요 없음
            }
            currR += stepR;
            currC += stepC;
        }
    }
    return false;
};
