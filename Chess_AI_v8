        const tR = parseInt(bookMoveStr[2]);
        const tC = parseInt(bookMoveStr[3]);
        const fromCell = getCell(fR, fC);
        const toCell = getCell(tR, tC);

        if (fromCell && toCell && fromCell.firstChild) {
            const piece = fromCell.firstChild.dataset.piece;
            const validMoves = getValidMoves(piece, fR, fC, internalBoardState);
            const legalMove = validMoves.find(m => m[0] === tR && m[1] === tC);

            if (legalMove) {
                const probability = ((weight / totalWeight) * 100).toFixed(1);
                console.log(`%c[Opening] ${bookMoveStr} (${probability}%)`, "color: #2196F3; font-weight: bold;");
                selectedCell = fromCell;
                fromCell.classList.add('ai-highlight');
                toCell.classList.add('ai-highlight');
                movePiece(toCell, legalMove[2]);
                setTimeout(() => {
                    fromCell.classList.remove('ai-highlight');
                    toCell.classList.remove('ai-highlight');
                }, 800);
                return;
            } else {
                console.warn(`Opening book has an illegal move: ${bookMoveStr}. Falling back to search.`);
            }
        }
    }
    // --- [오프닝 북 종료] ---

    const legalMoves = getLegalMoves(internalBoardState, aiColor);
    if (legalMoves.length === 0) {
        console.log(`AI (${aiColor}) has no legal moves. Game should be over.`);
        if (!gameOver) { gameOver = true; updateStatus(); }
        return;
    }

    const phase = getGamePhase();
    const targetDepth = (phase === 'endgame') ? endgame_depth : middlegame_depth;
    const currentHash = computeZobristHash(internalBoardState, aiColor);
    const hStr = currentHash.toString();

    console.log(`AI mode: ${phase === 'endgame' ? 'Endgame' : 'Middlegame'} (depth=${targetDepth})`);

    const EXPLORATION_RATE = 0.0;
    const isExploring = (phase === 'endgame') && (Math.random() < EXPLORATION_RATE);
    if (isExploring) {
        console.log("%cAI Mode: Exploring (Curiosity Driven)", "color: #ff9800; font-weight: bold;");
    }

    const isAiMaximizing = (aiColor === 'black');

    // --- [ID + Aspiration Window 루프] ---
    let moveScores = [];
    let prevBestScore = null;

    for (let d = 1; d <= targetDepth; d++) {
        searchStackHashes = [];
      
        // ✅ [추가] 이전 depth에서 얻은 moveScores를 기반으로 legalMoves 정렬
        // 이렇게 해야 다음 depth에서 가장 유망한 수를 먼저 탐색하여 AW와 AB 컷오프가 폭발적으로 일어납니다.
        if (moveScores.length > 0) {
            const scoreMap = new Map(moveScores.map(ms => [`${ms.move.from}${ms.move.to}`, ms.score]));
            legalMoves.sort((a, b) => {
                const scoreA = scoreMap.get(`${a.from}${a.to}`) ?? (isAiMaximizing ? -Infinity : Infinity);
                const scoreB = scoreMap.get(`${b.from}${b.to}`) ?? (isAiMaximizing ? -Infinity : Infinity);
                return isAiMaximizing ? scoreB - scoreA : scoreA - scoreB;
            });
        }

        const result = searchAtDepth(d, legalMoves, isAiMaximizing, phase, hStr, isExploring, prevBestScore);
        // 결과가 비어있지 않을 때만 업데이트 (안전장치)
        if (result.moveScores.length > 0) {
            moveScores = result.moveScores;
            prevBestScore = result.bestScore;
        }

        // 정렬 → 다음 depth TT hashMove ordering 개선
        moveScores.sort((a, b) => isAiMaximizing ? b.score - a.score : a.score - b.score);

        const best = moveScores[0];
        if (best) {
            const windowInfo = (prevBestScore !== null && d >= 3)
                ? `±${0.5} center=${prevBestScore.toFixed(2)}`
                : 'full';
            console.log(
                `%c[ID] depth=${d} best: ${best.move.piece}` +
                ` [${best.move.from}]->[${best.move.to}]` +
                ` score=${best.score.toFixed(2)} (window: ${windowInfo})`,
                "color: #b0bec5;"
            );
        }
    }

    // --- [성능 측정 종료] ---
    const endTime = performance.now();
    const timeTakenMs = endTime - startTime;
    const timeTakenSec = timeTakenMs / 1000;
    const nps = Math.floor(nodesVisited / timeTakenSec);
    const researchRate = lmrAttempts > 0
        ? ((lmrResearches / lmrAttempts) * 100).toFixed(1) : 0;

    console.log(`%c[LMR Stat] Attempts: ${lmrAttempts} | Researches: ${lmrResearches} | Rate: ${researchRate}%`, "color: #3ae374; font-weight: bold;");
    
    const rfpRate = rfpAttempts > 0 ? ((rfpPruned / rfpAttempts) * 100).toFixed(1) : 0;
    console.log(
        `%c[RFP Stat] Attempts: ${rfpAttempts} | Pruned: ${rfpPruned} | Rate: ${rfpRate}%`,
        "color: #ff9f43; font-weight: bold;"
    );
  
    const nmpRate = nmpAttempts > 0 ? ((nmpPruned / nmpAttempts) * 100).toFixed(1) : 0;
    console.log(
        `%c[NMP Stat] Attempts: ${nmpAttempts} | Pruned: ${nmpPruned} | Rate: ${nmpRate}%`,
        "color: #6c5ce7; font-weight: bold;"
    );
  
    console.log(`%c[Search Info] Depth: ${targetDepth} | Time: ${timeTakenMs.toFixed(2)}ms | Nodes: ${nodesVisited} | NPS: ${nps}`, "color: #00d1b2; font-weight: bold;");

    const count = tt.getEntryCount();
    const rate = tt.getFillRate();
    console.log(`%c[TT Info] Entries: ${count.toLocaleString()} / ${TT_SIZE.toLocaleString()} (${rate}%)`, "color: #ffdd57; font-weight: bold;");
  
    console.log(`%c[QS Stat] Max Depth: ${maxQsDepthReached} | NPS: ${nps}`, "color: #0097e6; font-weight: bold;");
  
    // ✅ 강력한 반복수 회피 (History Penalty)
const isAiWinning = isAiMaximizing ? prevBestScore > -1.0 : prevBestScore < 1.0;

moveScores.forEach(entry => {
    makeMove(internalBoardState, entry.move);
    const historyCount = positionHistory.get(currentBoardHash) || 0;
    unmakeMove(internalBoardState, entry.move);

    if (isAiWinning && historyCount >= 1) {
        entry.score += isAiMaximizing ? -5000.0 : 5000.0;
        console.log(`%c[History] Massive Penalty to ${entry.move.piece} (prevents repetition)`, "color: #ff5252; font-weight: bold;");
    }
});
  
  moveScores.sort((a, b) => isAiMaximizing ? b.score - a.score : a.score - b.score);

    // ✅ 2. 무승부 회피 로직 (필터링 정상화)
const bestSearchScore = moveScores[0]?.score;
if (bestSearchScore !== undefined) {
    if (isAiWinning && moveScores.length > 1) {
        const nonDrawMoves = moveScores.filter(entry => {
            // A. 즉시 무승부(3회반복/50수)가 되는가?
            const leadsToImmediateDraw = checkIfMoveleadsToDraw(
                entry.move.from[0], entry.move.from[1], 
                entry.move.to[0], entry.move.to[1], 
                entry.move.piece, entry.move.to[2]
            );
            if (leadsToImmediateDraw) return false;

            // B. [중요] 메이트 점수(±90000 이상)는 절대로 필터링하지 않음!
            if (Math.abs(entry.score) > 50000) return true;

            // C. 점수가 무승부 점수(handleDrawScore 반환값) 근처라면 무승부로 간주하여 제거
            // (contempt가 보통 2.0이므로 절대값 5.0 미만인 경우만 무승부 가능성 체크)
            if (Math.abs(entry.score) < 5.0) {
                 // handleDrawScore의 패널티를 받은 수인지 확인 (생략 가능하지만 안전함)
            }
            
            return true;
        });

        if (nonDrawMoves.length > 0 && nonDrawMoves.length < moveScores.length) {
            console.log(`%c[AI Choice] 유리함 판정. 무승부/반복 위험 수 ${moveScores.length - nonDrawMoves.length}개를 배제합니다.`, "color: #ff9800; font-weight: bold;");
            moveScores.length = 0;
            moveScores.push(...nonDrawMoves);
        }
    }
}

    // --- [수 선택] ---
    let chosenEntry = null;

    if (moveHistory.length < 6 && moveScores.length > 0) {
    // 1. 점수 순으로 먼저 정렬 (높은 점수가 앞에 오도록)
    moveScores.sort((a, b) => isAiMaximizing ? b.score - a.score : a.score - b.score);
    
    const bestScore = moveScores[0].score;
    // ✅ 허용 가능한 최대 점수 차이 (폰 0.3개 가치)
    // 이 값을 0.1로 낮추면 더 보수적으로, 0.5로 높이면 더 다양하게 둡니다.
    const ALLOWABLE_GAP = 0.5; 

    // 2. 최선의 수와 점수 차이가 적은 수들만 필터링
    const competitiveMoves = moveScores.filter(entry => {
        const gap = isAiMaximizing ? (bestScore - entry.score) : (entry.score - bestScore);
        return gap <= ALLOWABLE_GAP;
    });

    // 3. 걸러진 수 중에서 상위 최대 3개만 후보군으로 확정
    const topCount = Math.min(3, competitiveMoves.length);
    const finalCandidates = competitiveMoves.slice(0, topCount);

    chosenEntry = finalCandidates[Math.floor(Math.random() * finalCandidates.length)];
    
    console.log(`AI Opening (Competitive Random): ${chosenEntry.move.piece} [${chosenEntry.move.from}] -> [${chosenEntry.move.to}], Score: ${chosenEntry.score.toFixed(2)} (Gap: ${Math.abs(bestScore - chosenEntry.score).toFixed(2)})`);
} else if (moveScores.length > 0) {
        chosenEntry = moveScores.reduce((prev, curr) => {
            if (!prev) return curr;
            if (isAiMaximizing) return curr.score > prev.score ? curr : prev;
            return curr.score < prev.score ? curr : prev;
        }, null);
        if (chosenEntry) {
            console.log(`AI Normal Move: ${chosenEntry.move.piece} [${chosenEntry.move.from}] -> [${chosenEntry.move.to}], Best Score: ${chosenEntry.score.toFixed(2)}`);
        }
    }

    // --- [실행] ---
    if (chosenEntry) {
        const { move, score, searchDetails } = chosenEntry;

        makeMove(internalBoardState, move);
        const [sScore, sDetails] = evaluateBoard(internalBoardState, true);
        aiPendingStaticEval = { score: sScore, details: sDetails };
        aiPendingSearchScore = score;
        aiPendingSearchDetails = searchDetails;
        unmakeMove(internalBoardState, move);

        const fromCell = getCell(move.from[0], move.from[1]);
        const toCell = getCell(move.to[0], move.to[1]);

        if (fromCell && toCell && fromCell.firstChild) {
            const currentHighlightDuration = isSelfPlayMode ? 100 : 1000;
            fromCell.classList.add('ai-highlight');
            toCell.classList.add('ai-highlight');
            selectedCell = fromCell;
            movePiece(toCell, move.to[2]);
            setTimeout(() => {
                const currentFromCell = getCell(move.from[0], move.from[1]);
                const currentToCell = getCell(move.to[0], move.to[1]);
                if (currentFromCell) currentFromCell.classList.remove('ai-highlight');
                if (currentToCell) currentToCell.classList.remove('ai-highlight');
            }, currentHighlightDuration);
        }
    } else {
        console.error(`AI (${aiColor}) could not determine a move.`);
        switchTurn();
    }
};
