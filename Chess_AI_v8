    timers.black = timers.base;
    timers.currentDelay = 0;       // 딜레이 기록 초기화
    
    updateClockDisplay();          // 시계 UI 업데이트
    
    // PvP 모드이고 시간 제한이 있는 상태라면 다시 타이머 시작
    if (!gameOver && gameMode === 'pvp' && timers.mode !== 'none') {
