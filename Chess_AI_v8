// 비트보드 조작 헬퍼 함수
const BB_SET = (bb, sq) => bb | (1n << BigInt(sq));
const BB_CLEAR = (bb, sq) => bb & ~(1n << BigInt(sq));
const GET_SQ = (r, c) => r * 8 + c; // a8=0, h1=63 (기존 좌표계 유지)

// 비트보드에서 켜진 비트 개수(폰 개수)를 세는 빠른 함수
function popcount64(n) {
    let x = BigInt(n) & 0xFFFFFFFFFFFFFFFFn;
    
    // 1. 각 2비트 중 1의 개수를 구함
    x = x - ((x >> 1n) & 0x5555555555555555n);
    // 2. 각 4비트 중 1의 개수를 구함
    x = (x & 0x3333333333333333n) + ((x >> 2n) & 0x3333333333333333n);
    // 3. 각 8비트(1바이트) 중 1의 개수를 구함
    x = (x + (x >> 4n)) & 0x0F0F0F0F0F0F0F0Fn;
    
    // [중요] 여기서 곱셈 대신 단계적 합산을 사용 (JS BigInt 오염 방지)
    x += (x >> 8n);
    x += (x >> 16n);
    x += (x >> 32n);
    
    // 0~64 사이의 값만 남기기
    return Number(x & 0x7Fn);
}

