    for (let r = 0; r < 8; r++) {
        let row = "";
        for (let c = 0; c < 8; c++) {
            const bit = (bb >> BigInt(r * 8 + c)) & 1n;
            row += bit === 1n ? "P " : ". ";
        }
        result += row + "\n";
    }
    console.log(result);
}

// [Incremental Eval] 전역 점수 변수
// 흑색 유리 = 양수(+), 백색 유리 = 음수(-)
let currentMGScore = 0; // 미들게임 기준 (기물 점수 + PST)
let currentEGScore = 0; // 엔드게임 기준 (기물 점수 + PST)

/**
 * 기물 하나에 대한 [미들게임 점수, 엔드게임 점수]를 반환합니다.
 */
function getPieceStaticScore(piece, r, c) {
    if (!piece) return [0, 0];
    
    const isWhite = piece === piece.toUpperCase();
    const pUpper = piece.toUpperCase();
    const sign = isWhite ? -1 : 1; // 백색은 감점, 흑색은 가점
    const pRow = isWhite ? r : 7 - r; // 흑색은 행을 반전하여 PST 적용
    
    const material = pieceValues[pUpper];
    let pstMG = 0;
    let pstEG = 0;

    // PST 테이블 매핑
    switch (pUpper) {
        case 'P': pstMG = pstEG = pawnPositionValues[pRow][c]; break;
        case 'N': pstMG = pstEG = knightPositionValues[pRow][c]; break;
        case 'B': pstMG = pstEG = bishopPositionValues[pRow][c]; break;
        case 'R': pstMG = pstEG = rookPositionValues[pRow][c]; break;
        case 'Q': pstMG = pstEG = knightPositionValues[pRow][c] * 0.5; break;
        case 'K':
            pstMG = kingMiddleGameValues[pRow][c];
            pstEG = kingEndGameValues[pRow][c];
            break;
    }

    return [
        (material + pstMG) * sign,
        (material + pstEG) * sign
    ];
}

let totalWhiteMaterial = 0;
let totalBlackMaterial = 0;

function initIncrementalEval() {
    currentMGScore = 0;
    currentEGScore = 0;
    totalWhiteMaterial = 0;
    totalBlackMaterial = 0;

    for (let r = 0; r < 8; r++) {
        for (let c = 0; c < 8; c++) {
            const piece = internalBoardState[r][c];
            if (piece) {
                const [mg, eg] = getPieceStaticScore(piece, r, c);
                currentMGScore += mg;
                currentEGScore += eg;
                
                // 순수 기물 가치만 따로 합산
                const val = pieceValues[piece.toUpperCase()];
                if (piece === piece.toUpperCase()) totalWhiteMaterial += val;
                else totalBlackMaterial += val;
            }
        }
    }
}

